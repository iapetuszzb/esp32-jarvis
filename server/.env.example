# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=replace-with-your-own-random-token-at-least-24-characters
JARVIS_MODEL_PATH=/data/jarvis-minicpm/models/MiniCPM-o-4_5
JARVIS_MOCK=0
JARVIS_FRAME_TTL=4
